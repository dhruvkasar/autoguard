# Copy to .env and fill values. Do not commit real secrets.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs, e.g., 123456789,987654321
TELEGRAM_CHAT_IDS=
# Optional: camera identifier string for alerts
CAMERA_ID=CAM01

# Flask secret key for CSRF protection (generate with: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=

# Database mode (set to 'true' to use SQLite database instead of JSON files)
USE_DATABASE=false

# Viewer server role tokens (example values; set securely)
ADMIN_TOKEN=
SECURITY_TOKEN=
VIEWER_TOKEN=
