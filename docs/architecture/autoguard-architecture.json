  "cards": [
    {
      "dot": "cyan",
      "title": "Detection Pipeline",
      "items": [
        "YOLOv8 person detection with 0.35 confidence threshold",
        "ByteTrack maintains persistent IDs across frames",
        "Three configurable zones: Shelf, Checkout, Exit",
        "Behavioral rules: loitering, exit-without-checkout, repeated shelf-exit patterns"
      ]
    },
    {
      "dot": "emerald",
      "title": "Evidence & Storage",
      "items": [
        "Automatic snapshot capture on rule violations with SHA-256 integrity hashing",
        "Dual storage: JSON files (backward compatibility) + SQLite database (efficient queries)",
        "Priority classification (high/standard) with resolution tracking",
        "7-day automatic retention policy with configurable extension"
      ]
    },
    {
      "dot": "violet",
      "title": "Web Dashboard",
      "items": [
        "Role-based access control: Admin (full), Security (manage evidence), Viewer (read-only)",
        "Live MJPEG video streaming with multi-client support and FPS statistics",
        "Evidence filtering by date range, rule type, camera ID, priority level",
        "Rate limiting: 120 requests/min for evidence endpoints, 30 requests/min for exports"
      ]
    },
    {
      "dot": "rose",
      "title": "Security Boundaries",
      "items": [
        "Token-based authentication with constant-time comparison prevents timing attacks",
        "HTTPOnly cookies with Secure + SameSite=Strict flags, 12-hour session timeout",
        "Security headers: CSP, HSTS, X-Frame-Options DENY, X-Content-Type-Options nosniff",
        "Path traversal prevention with filename validation and directory containment checks",
        "Docker deployment with non-root user (uid 1000), local-only binding by default"
      ]
    }
  ]
